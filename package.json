{
  "name": "jazz-notes",
  "version": "0.1.0-beta.2",
  "description": "Second Brain — note-taking with Markdown files",
  "main": "./out/main/index.js",
  "author": "jazz-crab <tvesnz@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:all": "electron-vite build && electron-builder --linux --win && node -e \"const fs=require('fs'); try{fs.renameSync('dist/jazz-notes-linux-x64.pacman','dist/jazz-notes-linux-x86_64.pacman')}catch(e){}\"",
    "postdist": "node -e \"const fs=require('fs'); try{fs.renameSync('dist/jazz-notes-linux-x64.pacman','dist/jazz-notes-linux-x86_64.pacman')}catch(e){}\"",
    "web:build": "vite build --config web/vite.config.ts && esbuild web/server.ts --bundle --platform=node --format=cjs --outfile=web/dist-server/server.js",
    "web:dev": "vite --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@atomic-editor/editor": "^0.6.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@dnd-kit/core": "^6.3.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "call-bind-apply-helpers": "^1.0.2",
    "chokidar": "^4.0.3",
    "isomorphic-git": "^1.40.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.7",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "zustand": "^5.0.4"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
